@{
    var title = ViewData["Title"] as string ?? "متابعة العينات";
    var subtitle = ViewData["Subtitle"] as string;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title — نظام متابعة العينات</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="topbar">
        <div class="brand">
            <div class="mark">ع</div>
            <div>متابعة العينات <small>@subtitle</small></div>
        </div>
        <div class="right">
            <span class="who">@User.Identity?.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                <button type="submit" class="out">خروج</button>
            </form>
        </div>
    </div>

    <div class="wrap">
        @RenderBody()
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
