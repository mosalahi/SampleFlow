@model UserCreateViewModel
@{
    ViewData["Title"] = "مستخدم جديد";
    ViewData["Subtitle"] = "لوحة الإدارة";
}

<div class="page-head">
    <div><h2>إضافة مستخدم</h2></div>
</div>

<div class="card" style="max-width:620px;">
    <div class="card-b">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert-error"></div>

            <div class="form-grid">
                <div class="field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" type="email" autocomplete="off" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Role"></label>
                    <select asp-for="Role" asp-items="Model.RoleOptions"></select>
                    <span asp-validation-for="Role" class="field-validation-error"></span>
                </div>
                <div class="field">
                    <label asp-for="CenterId"></label>
                    <select asp-for="CenterId" asp-items="Model.CenterOptions">
                        <option value="">— (للمشرف/الأدمن)</option>
                    </select>
                    <span asp-validation-for="CenterId" class="field-validation-error"></span>
                </div>
            </div>
            <div class="desc" style="margin-top:.5rem;">اختر مركزاً فقط لدور «Center».</div>

            <div class="form-actions">
                <button type="submit" class="btn btn-amber btn-sm">إنشاء</button>
                <a class="btn btn-ghost btn-sm" asp-action="Index">إلغاء</a>
            </div>
        </form>
    </div>
</div>
