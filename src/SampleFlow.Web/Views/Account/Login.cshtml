@model LoginViewModel
@{
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول — نظام متابعة العينات</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="login-stage">
        <div class="login-card">
            <div class="logo">ع</div>
            <h1>نظام متابعة العينات اليومية</h1>
            <p class="sub">سجّل الدخول لإضافة بيانات اليوم أو متابعة التجميع</p>

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="alert-error" role="alert"></div>

                <div class="field">
                    <label asp-for="UserName"></label>
                    <input asp-for="UserName" autocomplete="username" autofocus />
                    <span asp-validation-for="UserName" class="field-validation-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <label class="checkbox">
                    <input asp-for="RememberMe" /> <span>تذكّرني</span>
                </label>

                <button type="submit" class="btn">دخول</button>
            </form>
        </div>
    </div>
</body>
</html>
